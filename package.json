{
  "name": "carteira-pt",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Expense tracker com sugestões para a realidade portuguesa (PWA + Android)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "android:add": "cap add android",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "build:artifact": "tsc -b && vite build --mode artifact && node scripts/build-artifact.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.11",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "~5.8",
    "vite": "^7.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
