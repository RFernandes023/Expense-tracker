# Copia para .env.local (desenvolvimento com `vercel dev`) e define os mesmos valores na Vercel.
# NUNCA faças commit do ficheiro com valores reais.

# MongoDB Atlas (Connect → Drivers)
MONGODB_URI=mongodb+srv://UTILIZADOR:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=carteira

# Google OAuth (Google Cloud → Google Auth Platform → Clients → Web application)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Gemini (Google AI Studio → Get API key)
GEMINI_API_KEY=AIza...
# Opcional: modelo a usar (por omissão gemini-2.5-flash)
GEMINI_MODEL=

# Segredo para assinar as sessões (texto aleatório longo, mín. 32 caracteres)
JWT_SECRET=

# URL público da app (sem barra final). Em local: http://localhost:3000
APP_URL=https://carteira-pt.vercel.app

# Opcional: só estas contas podem entrar (separadas por vírgula). Vazio = qualquer conta Google.
ALLOWED_EMAILS=

# Opcional: máximo de faturas lidas por utilizador por dia (por omissão 30; 0 = sem limite)
OCR_DAILY_LIMIT=30
